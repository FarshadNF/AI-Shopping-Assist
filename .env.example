APP_PORT=8000
POSTGRES_DB=shopping_assist
POSTGRES_USER=shopping_assist
POSTGRES_PASSWORD=shopping_assist
POSTGRES_HOST_PORT=5433
CHAT_MEMORY_LIMIT=20
CHAT_MEMORY_DATABASE_URL=postgresql://shopping_assist:shopping_assist@127.0.0.1:5433/shopping_assist
CHAT_MEMORY_SESSION_KEY=ai-agent-cli

# Create and manage this in Google AI Studio API Keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_DELAY=1
GEMINI_RETRY_MAX_DELAY=6
GEMINI_KEY_COOLDOWN_SECONDS=30
GEMINI_KEY_COOLDOWN_MAX_SECONDS=300
GEMINI_KEY_PERMISSION_COOLDOWN_SECONDS=3600

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
AI_ASSISTANT_CORS_ALLOW_ALL=0
AI_ASSISTANT_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
AI_ASSISTANT_SYNC_TOKEN=
AI_ASSISTANT_MAX_CATALOG_ITEMS=5000
AI_ASSISTANT_ASYNC_CATALOG_IMPORT=1
OPENCART_BASE_URL=http://localhost/test-shop/
OPENCART_CATALOG_ROUTE=index.php?route=extension/ai_shopping_assist/module/ai_shopping_assist.getCatalog
OPENCART_CATALOG_URL=
OPENCART_SYNC_TOKEN=
OPENCART_TIMEOUT=15
