{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div id="manu-alert"></div>
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}

    <div class="card mb-4">
      <div class="card-header"><i class="fa-solid fa-robot"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_manu_status" value="0"/>
                <input type="checkbox" name="module_manu_status" value="1" id="input-status" class="form-check-input"{% if module_manu_status %} checked{% endif %}/>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-gemini-api-key" class="col-sm-2 col-form-label">{{ entry_gemini_api_key }}</label>
            <div class="col-sm-10">
              <textarea name="module_manu_gemini_api_key" rows="3" placeholder="KEY_1, KEY_2, KEY_3" id="input-gemini-api-key" class="form-control" autocomplete="off">{{ module_manu_gemini_api_key }}</textarea>
              <div class="form-text">{{ help_gemini_api_key }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-gemini-model" class="col-sm-2 col-form-label">{{ entry_gemini_model }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_gemini_model" value="{{ module_manu_gemini_model }}" placeholder="gemini-2.5-flash" id="input-gemini-model" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-gemini-temperature" class="col-sm-2 col-form-label">{{ entry_gemini_temperature }}</label>
            <div class="col-sm-10">
              <input type="number" step="0.1" min="0" max="1" name="module_manu_gemini_temperature" value="{{ module_manu_gemini_temperature }}" id="input-gemini-temperature" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-catalog-limit" class="col-sm-2 col-form-label">{{ entry_catalog_limit }}</label>
            <div class="col-sm-10">
              <input type="number" min="5" max="200" name="module_manu_catalog_limit" value="{{ module_manu_catalog_limit }}" id="input-catalog-limit" class="form-control"/>
              <div class="form-text">{{ help_catalog_limit }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-store-brand" class="col-sm-2 col-form-label">{{ entry_store_brand }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_store_brand" value="{{ module_manu_store_brand }}" id="input-store-brand" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-assistant-name" class="col-sm-2 col-form-label">{{ entry_assistant_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_assistant_name" value="{{ module_manu_assistant_name }}" id="input-assistant-name" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-sitemap-url" class="col-sm-2 col-form-label">{{ entry_sitemap_url }}</label>
            <div class="col-sm-10">
              <input type="url" name="module_manu_sitemap_url" value="{{ module_manu_sitemap_url }}" placeholder="https://example.com/sitemap.xml" id="input-sitemap-url" class="form-control"/>
              <div class="form-text">{{ help_sitemap_url }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-system-prompt" class="col-sm-2 col-form-label">{{ entry_system_prompt }}</label>
            <div class="col-sm-10">
              <textarea name="module_manu_system_prompt" rows="5" id="input-system-prompt" class="form-control">{{ module_manu_system_prompt }}</textarea>
              <div class="form-text">{{ help_system_prompt }}</div>
            </div>
          </div>

          <div class="row mb-4">
            <label class="col-sm-2 col-form-label">{{ entry_agent_prompts }}</label>
            <div class="col-sm-10">
              <div class="card">
                <div class="card-header d-flex align-items-center gap-2">
                  <i class="fa-solid fa-users-gear"></i>
                  <strong>{{ text_agent_prompts }}</strong>
                </div>
                <div class="card-body p-0">
                  <ul class="nav nav-tabs flex-nowrap overflow-auto px-3 pt-3" id="agent-prompt-tabs" role="tablist">
                    {% for agent in agent_prompts %}
                      <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link text-nowrap{% if loop.first %} active{% endif %}" id="agent-tab-{{ agent.key }}" data-bs-toggle="tab" data-bs-target="#agent-pane-{{ agent.key }}" role="tab" aria-controls="agent-pane-{{ agent.key }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
                          {{ agent.name }}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>

                  <div class="tab-content p-3" id="agent-prompt-content">
                    {% for agent in agent_prompts %}
                      <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="agent-pane-{{ agent.key }}" role="tabpanel" aria-labelledby="agent-tab-{{ agent.key }}" tabindex="0">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                          <div>
                            <strong>{{ agent.name }}</strong>
                            <span class="badge bg-light text-dark border ms-1">{{ agent.role }}</span>
                          </div>
                          <span class="text-muted small">{{ agent.value|length }} / 8000</span>
                        </div>
                        <textarea name="{{ agent.setting_key }}" rows="9" maxlength="8000" id="input-prompt-{{ agent.key }}" class="form-control" dir="auto">{{ agent.value }}</textarea>
                        <div class="form-text">{{ help_agent_prompt }}</div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="form-text mt-2">{{ help_agent_prompts }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-catalog-token" class="col-sm-2 col-form-label">{{ entry_catalog_token }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_catalog_token" value="{{ module_manu_catalog_token }}" id="input-catalog-token" class="form-control"/>
              <div class="form-text">{{ help_catalog_token }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_footer_injection }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_manu_footer_injection" value="0"/>
                <input type="checkbox" name="module_manu_footer_injection" value="1" id="input-footer-injection" class="form-check-input"{% if module_manu_footer_injection %} checked{% endif %}/>
              </div>
            </div>
          </div>

          <fieldset class="mb-3">
            <legend class="fs-6"><i class="fa-solid fa-lightbulb"></i> {{ text_suggestion_controls }}</legend>
            <div class="form-text mb-3">{{ help_suggestion_controls }}</div>

            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_suggest_next_questions }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="module_manu_suggest_next_questions" value="0"/>
                  <input type="checkbox" name="module_manu_suggest_next_questions" value="1" id="input-suggest-next-questions" class="form-check-input"{% if module_manu_suggest_next_questions %} checked{% endif %}/>
                </div>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_suggest_blogs }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="module_manu_suggest_blogs" value="0"/>
                  <input type="checkbox" name="module_manu_suggest_blogs" value="1" id="input-suggest-blogs" class="form-check-input"{% if module_manu_suggest_blogs %} checked{% endif %}/>
                </div>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_suggest_categories }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="module_manu_suggest_categories" value="0"/>
                  <input type="checkbox" name="module_manu_suggest_categories" value="1" id="input-suggest-categories" class="form-check-input"{% if module_manu_suggest_categories %} checked{% endif %}/>
                </div>
              </div>
            </div>

            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_suggest_products }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="module_manu_suggest_products" value="0"/>
                  <input type="checkbox" name="module_manu_suggest_products" value="1" id="input-suggest-products" class="form-check-input"{% if module_manu_suggest_products %} checked{% endif %}/>
                </div>
              </div>
            </div>
          </fieldset>

          <div class="row mb-3">
            <label for="input-widget-title" class="col-sm-2 col-form-label">{{ entry_widget_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_widget_title" value="{{ module_manu_widget_title }}" id="input-widget-title" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-widget-button" class="col-sm-2 col-form-label">{{ entry_widget_button }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_widget_button" value="{{ module_manu_widget_button }}" id="input-widget-button" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-redirect-utm" class="col-sm-2 col-form-label">{{ entry_redirect_utm }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_manu_redirect_utm" value="{{ module_manu_redirect_utm }}" id="input-redirect-utm" class="form-control" placeholder="utm_source=manu&utm_medium=assistant&utm_campaign=chat"/>
              <div class="form-text">{{ help_redirect_utm }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-database"></i> Manu data</div>
      <div class="card-body">
        <ul class="nav nav-tabs" id="manu-data-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{% if active_tab == 'logs' %} active{% endif %}" id="tab-manu-logs-btn" data-bs-toggle="tab" data-bs-target="#tab-manu-logs" role="tab" aria-controls="tab-manu-logs" aria-selected="{% if active_tab == 'logs' %}true{% else %}false{% endif %}"><i class="fa-solid fa-comments"></i> {{ text_logs }}</button>
          </li>
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{% if active_tab == 'indexed-pages' %} active{% endif %}" id="tab-manu-indexed-pages-btn" data-bs-toggle="tab" data-bs-target="#tab-manu-indexed-pages" role="tab" aria-controls="tab-manu-indexed-pages" aria-selected="{% if active_tab == 'indexed-pages' %}true{% else %}false{% endif %}"><i class="fa-solid fa-sitemap"></i> {{ text_indexed_pages }} <span class="badge bg-secondary">{{ sitemap_pages_total }}</span></button>
          </li>
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{% if active_tab == 'redirects' %} active{% endif %}" id="tab-manu-redirects-btn" data-bs-toggle="tab" data-bs-target="#tab-manu-redirects" role="tab" aria-controls="tab-manu-redirects" aria-selected="{% if active_tab == 'redirects' %}true{% else %}false{% endif %}"><i class="fa-solid fa-location-arrow"></i> {{ text_redirect_logs }} <span class="badge bg-secondary">{{ redirect_logs_total }}</span></button>
          </li>
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{% if active_tab == 'leads' %} active{% endif %}" id="tab-manu-leads-btn" data-bs-toggle="tab" data-bs-target="#tab-manu-leads" role="tab" aria-controls="tab-manu-leads" aria-selected="{% if active_tab == 'leads' %}true{% else %}false{% endif %}"><i class="fa-solid fa-user-plus"></i> {{ text_leads }} <span class="badge bg-secondary">{{ leads_total }}</span></button>
          </li>
        </ul>

        <div class="tab-content pt-3">
          <div class="tab-pane fade{% if active_tab == 'logs' %} show active{% endif %}" id="tab-manu-logs" role="tabpanel" aria-labelledby="tab-manu-logs-btn" tabindex="0">
            <div class="d-flex justify-content-end gap-2 mb-3">
              <a href="{{ export_logs }}" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-file-excel"></i> {{ text_export_excel }}</a>
              <button type="button" id="button-clear-logs" data-url="{{ clear_logs }}" class="btn btn-sm btn-outline-danger">{{ text_clear_logs }}</button>
            </div>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{ column_date }}</th>
                    <th>{{ column_conversation }}</th>
                    <th>{{ column_customer }}</th>
                    <th>{{ column_role }}</th>
                    <th>{{ column_content }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% if logs %}
                    {% for log in logs %}
                      <tr>
                        <td class="text-nowrap">{{ log.date_added }}</td>
                        <td><code>{{ log.conversation_id }}</code></td>
                        <td>{{ log.customer_id ? log.customer_id : '-' }}</td>
                        <td>{{ log.role }}</td>
                        <td style="max-width: 560px; white-space: normal;">{{ log.content|slice(0, 240) }}{% if log.content|length > 240 %}...{% endif %}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">{{ text_no_logs }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-end mt-3">{{ logs_pagination }}</div>
          </div>

          <div class="tab-pane fade{% if active_tab == 'indexed-pages' %} show active{% endif %}" id="tab-manu-indexed-pages" role="tabpanel" aria-labelledby="tab-manu-indexed-pages-btn" tabindex="0">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
              <div><strong>{{ text_cache_status }}:</strong> {{ sitemap_cache_status }}</div>
              {% if warm_sitemap_url %}
                <div class="d-flex gap-2">
                  <button type="button" id="button-warm-sitemap-all" class="btn btn-sm btn-success"><i class="fa-solid fa-play"></i> {{ text_warm_sitemap_all }}</button>
                  <a href="{{ warm_sitemap_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="fa-solid fa-arrows-rotate"></i> {{ text_warm_sitemap }}</a>
                </div>
              {% endif %}
            </div>
            <div id="warm-sitemap-progress" class="alert alert-info d-none"></div>

            <div class="border rounded p-3 mb-3 bg-light">
              <form action="{{ upload_sitemap }}" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-lg-8">
                  <label for="input-sitemap-file" class="form-label">{{ text_upload_sitemap }}</label>
                  <input type="file" name="sitemap_file" id="input-sitemap-file" accept=".xml,.gz,.xml.gz" class="form-control">
                  <div class="form-text">{{ help_upload_sitemap }}</div>
                </div>
                <div class="col-lg-4">
                  <button type="submit" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-upload"></i> {{ button_upload_sitemap }}</button>
                </div>
              </form>
              <div class="mt-3"><strong>{{ text_uploaded_sitemap }}:</strong> {{ uploaded_sitemap_status }}</div>
              <pre class="mt-2 mb-0 small" style="max-height: 180px; overflow: auto; white-space: pre-wrap;">{{ uploaded_sitemap_diagnostics }}</pre>
            </div>

            <form action="index.php" method="get" class="row g-2 align-items-end mb-3">
              <input type="hidden" name="route" value="extension/manu/module/manu"/>
              <input type="hidden" name="user_token" value="{{ user_token }}"/>
              <input type="hidden" name="tab" value="indexed-pages"/>
              <div class="col-md-4">
                <input type="text" name="sitemap_search" value="{{ sitemap_search }}" class="form-control form-control-sm" placeholder="{{ text_search }}"/>
              </div>
              <div class="col-md-3">
                <select name="sitemap_type" class="form-select form-select-sm">
                  <option value="">{{ text_filter_all_types }}</option>
                  {% for type in sitemap_types %}
                    <option value="{{ type }}"{% if sitemap_type == type %} selected{% endif %}>{{ type }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-light"><i class="fa-solid fa-filter"></i> {{ button_filter }}</button>
                {% if sitemap_search or sitemap_type %}
                  <a href="{{ module_url }}&amp;tab=indexed-pages" class="btn btn-sm btn-link">{{ button_clear_filter }}</a>
                {% endif %}
              </div>
            </form>

            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{ column_cached_at }}</th>
                    <th>{{ column_type }}</th>
                    <th>{{ column_title }}</th>
                    <th>{{ column_url }}</th>
                    <th>{{ column_summary }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% if sitemap_pages %}
                    {% for page in sitemap_pages %}
                      <tr>
                        <td class="text-nowrap">{{ page.fetched_at }}</td>
                        <td><span class="badge bg-info text-dark">{{ page.content_type }}</span></td>
                        <td>{{ page.title }}</td>
                        <td><a href="{{ page.url }}" target="_blank" rel="noopener">{{ page.url }}</a></td>
                        <td>{{ page.summary }}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">{{ text_no_indexed_pages }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-end mt-3">{{ sitemap_pages_pagination }}</div>
          </div>

          <div class="tab-pane fade{% if active_tab == 'redirects' %} show active{% endif %}" id="tab-manu-redirects" role="tabpanel" aria-labelledby="tab-manu-redirects-btn" tabindex="0">
            <div class="d-flex justify-content-end gap-2 mb-3">
              <a href="{{ export_redirect_logs }}" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-file-excel"></i> {{ text_export_excel }}</a>
              <button type="button" id="button-clear-redirect-logs" data-url="{{ clear_redirect_logs }}" class="btn btn-sm btn-outline-danger">{{ text_clear_redirect_logs }}</button>
            </div>
            <form action="index.php" method="get" class="row g-2 align-items-end mb-3">
              <input type="hidden" name="route" value="extension/manu/module/manu"/>
              <input type="hidden" name="user_token" value="{{ user_token }}"/>
              <input type="hidden" name="tab" value="redirects"/>
              <div class="col-md-4">
                <input type="text" name="redirect_search" value="{{ redirect_search }}" class="form-control form-control-sm" placeholder="{{ text_search }}"/>
              </div>
              <div class="col-md-3">
                <select name="redirect_action" class="form-select form-select-sm">
                  <option value="">{{ text_filter_all_actions }}</option>
                  {% for action in redirect_actions %}
                    <option value="{{ action }}"{% if redirect_action == action %} selected{% endif %}>{{ action }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-light"><i class="fa-solid fa-filter"></i> {{ button_filter }}</button>
                {% if redirect_search or redirect_action %}
                  <a href="{{ module_url }}&amp;tab=redirects" class="btn btn-sm btn-link">{{ button_clear_filter }}</a>
                {% endif %}
              </div>
            </form>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{ column_date }}</th>
                    <th>{{ column_conversation }}</th>
                    <th>{{ column_action_type }}</th>
                    <th>{{ column_source_url }}</th>
                    <th>{{ column_destination_url }}</th>
                    <th>{{ column_destination_url_utm }}</th>
                    <th>{{ column_utm_payload }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% if redirect_logs %}
                    {% for row in redirect_logs %}
                      <tr>
                        <td class="text-nowrap">{{ row.date_added }}</td>
                        <td><code>{{ row.conversation_id }}</code></td>
                        <td>{{ row.action_type }}</td>
                        <td><a href="{{ row.source_url }}" target="_blank" rel="noopener">{{ row.source_url }}</a></td>
                        <td><a href="{{ row.destination_url }}" target="_blank" rel="noopener">{{ row.destination_url }}</a></td>
                        <td><a href="{{ row.destination_url_utm }}" target="_blank" rel="noopener">{{ row.destination_url_utm }}</a></td>
                        <td><code>{{ row.utm_payload }}</code></td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">{{ text_no_redirect_logs }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-end mt-3">{{ redirect_logs_pagination }}</div>
          </div>

          <div class="tab-pane fade{% if active_tab == 'leads' %} show active{% endif %}" id="tab-manu-leads" role="tabpanel" aria-labelledby="tab-manu-leads-btn" tabindex="0">
            <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
              <button type="button" id="button-repair-lead-storage" data-url="{{ repair_lead_storage }}" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-database"></i> {{ text_repair_lead_storage }}</button>
              <a href="{{ export_leads }}" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-file-excel"></i> {{ text_export_excel }}</a>
              <button type="button" id="button-clear-leads" data-url="{{ clear_leads }}" class="btn btn-sm btn-outline-danger">{{ text_clear_leads }}</button>
            </div>
            <form action="index.php" method="get" class="row g-2 align-items-end mb-3">
              <input type="hidden" name="route" value="extension/manu/module/manu"/>
              <input type="hidden" name="user_token" value="{{ user_token }}"/>
              <input type="hidden" name="tab" value="leads"/>
              <div class="col-md-6">
                <input type="text" name="lead_search" value="{{ lead_search }}" class="form-control form-control-sm" placeholder="{{ text_search }}"/>
              </div>
              <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-light"><i class="fa-solid fa-filter"></i> {{ button_filter }}</button>
                {% if lead_search %}
                  <a href="{{ module_url }}&amp;tab=leads" class="btn btn-sm btn-link">{{ button_clear_filter }}</a>
                {% endif %}
              </div>
            </form>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{ column_date }}</th>
                    <th>{{ column_request_id }}</th>
                    <th>{{ column_item }}</th>
                    <th>{{ column_product_name }}</th>
                    <th>{{ column_product_identity }}</th>
                    <th>{{ column_qty }}</th>
                    <th>{{ column_item_details }}</th>
                    <th>{{ column_requirements }}</th>
                    <th>{{ column_name }}</th>
                    <th>{{ column_contact }}</th>
                    <th>{{ column_delivery_location }}</th>
                    <th>{{ column_page_url }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% if leads %}
                    {% for row in leads %}
                      <tr>
                        <td class="text-nowrap">{{ row.date_added }}</td>
                        <td><code title="{{ column_conversation }}: {{ row.conversation_id }}">{{ row.request_id ?: row.conversation_id }}</code></td>
                        <td class="text-center">{{ row.item_index }}</td>
                        <td>{{ row.product_name }}</td>
                        <td>
                          {% if row.brand %}<div><strong>{{ column_brand }}:</strong> {{ row.brand }}</div>{% endif %}
                          {% if row.model %}<div><strong>{{ column_model }}:</strong> {{ row.model }}</div>{% endif %}
                          {% if row.part_number %}<div><strong>{{ column_part_number }}:</strong> <code>{{ row.part_number }}</code></div>{% endif %}
                          {% if not row.brand and not row.model and not row.part_number %}-{% endif %}
                        </td>
                        <td>{{ row.qty }}{% if row.unit %} {{ row.unit }}{% endif %}</td>
                        <td style="min-width: 180px; white-space: pre-wrap;">{{ row.item_details ?: '-' }}</td>
                        <td style="min-width: 220px; white-space: pre-wrap;">{{ row.requirements ?: '-' }}</td>
                        <td>{{ row.name }}</td>
                        <td>
                          {% if row.contact_number %}<div>{{ row.contact_number }}</div>{% endif %}
                          {% if row.email %}<div>{{ row.email }}</div>{% endif %}
                          {% if row.company %}<small class="text-muted">{{ row.company }}</small>{% endif %}
                        </td>
                        <td>{{ row.delivery_location }}</td>
                        <td>{% if row.page_url %}<a href="{{ row.page_url }}" target="_blank" rel="noopener" title="{{ row.page_title }}">{{ row.page_url }}</a>{% else %}-{% endif %}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="12" class="text-center text-muted py-4">{{ text_no_leads }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="text-end mt-3">{{ leads_pagination }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function manuAlert(type, message) {
  var alert = document.createElement('div');
  alert.className = 'alert alert-' + type + ' alert-dismissible';
  alert.innerHTML = '<i class="fa-solid fa-' + (type === 'danger' ? 'circle-exclamation' : 'circle-check') + '"></i> ' + message
    + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
  var box = document.getElementById('manu-alert');
  box.innerHTML = '';
  box.appendChild(alert);
}

function manuPost(url, onSuccess) {
  fetch(url, { method: 'POST', credentials: 'same-origin' })
    .then(function (response) { return response.json(); })
    .then(onSuccess)
    .catch(function () { manuAlert('danger', 'Request failed.'); });
}

var clearLogsButton = document.getElementById('button-clear-logs');
if (clearLogsButton) {
  clearLogsButton.addEventListener('click', function () {
    if (!confirm('{{ text_clear_logs|e('js') }}?')) return;
    manuPost(this.dataset.url, function () { window.location.reload(); });
  });
}

var clearRedirectLogsButton = document.getElementById('button-clear-redirect-logs');
if (clearRedirectLogsButton) {
  clearRedirectLogsButton.addEventListener('click', function () {
    if (!confirm('{{ text_clear_redirect_logs|e('js') }}?')) return;
    manuPost(this.dataset.url, function () { window.location.reload(); });
  });
}

var clearLeadsButton = document.getElementById('button-clear-leads');
if (clearLeadsButton) {
  clearLeadsButton.addEventListener('click', function () {
    if (!confirm('{{ text_clear_leads|e('js') }}?')) return;
    manuPost(this.dataset.url, function () { window.location.reload(); });
  });
}

var repairLeadStorageButton = document.getElementById('button-repair-lead-storage');
if (repairLeadStorageButton) {
  repairLeadStorageButton.addEventListener('click', function () {
    var button = this;
    button.disabled = true;
    fetch(button.dataset.url, { method: 'POST', credentials: 'same-origin' })
      .then(function (response) { return response.json(); })
      .then(function (json) {
        if (json.error) {
          manuAlert('danger', json.error);
        } else {
          manuAlert('success', json.success || 'Lead storage is ready.');
        }
      })
      .catch(function () { manuAlert('danger', 'Lead storage repair failed.'); })
      .finally(function () { button.disabled = false; });
  });
}

var warmSitemapAllButton = document.getElementById('button-warm-sitemap-all');
if (warmSitemapAllButton) {
  warmSitemapAllButton.addEventListener('click', function () {
    var button = this;
    var progress = document.getElementById('warm-sitemap-progress');
    var baseUrl = '{{ warm_sitemap_url|default('')|e('js') }}';
    if (!baseUrl) return;

    var runIndex = 0;
    var totalCrawled = 0;

    function buildUrl(refreshFlag) {
      var separator = baseUrl.indexOf('?') !== -1 ? '&' : '?';
      return baseUrl + separator + '_ts=' + Date.now() + '&limit=80&refresh=' + (refreshFlag ? '1' : '0');
    }

    function setProgress(message, type) {
      progress.className = 'alert alert-' + (type || 'info');
      progress.textContent = message;
      progress.classList.remove('d-none');
    }

    function runBatch() {
      var isFirst = runIndex === 0;
      fetch(buildUrl(isFirst), { credentials: 'same-origin', signal: AbortSignal.timeout ? AbortSignal.timeout(90000) : undefined })
        .then(function (response) { return response.json(); })
        .then(function (json) {
          if (!json || json.success === false) {
            setProgress('{{ text_warm_sitemap_failed|e('js') }} ' + ((json && (json.error || json.fetch_error)) || ''), 'danger');
            button.disabled = false;
            return;
          }

          runIndex += 1;
          totalCrawled += Number(json.crawled_pages || 0);
          var remaining = Number(json.remaining_pages || 0);
          var total = Number(json.total_pages || 0);
          var cached = Number(json.cached_pages || 0);

          setProgress('{{ text_warm_sitemap_progress|e('js') }} ' + cached + '/' + total + ' | {{ text_warm_sitemap_remaining|e('js') }} ' + remaining + ' | {{ text_warm_sitemap_batches|e('js') }} ' + runIndex);

          if (remaining > 0 && Number(json.crawled_pages || 0) > 0) {
            window.setTimeout(runBatch, 500);
            return;
          }

          if (remaining > 0 && Number(json.crawled_pages || 0) === 0) {
            setProgress('{{ text_warm_sitemap_stalled|e('js') }} ' + remaining, 'danger');
            button.disabled = false;
            return;
          }

          setProgress('{{ text_warm_sitemap_done|e('js') }} ' + totalCrawled + ' / ' + total, 'success');
          window.setTimeout(function () { window.location.reload(); }, 1200);
        })
        .catch(function () {
          setProgress('{{ text_warm_sitemap_timeout|e('js') }}', 'danger');
          button.disabled = false;
        });
    }

    button.disabled = true;
    setProgress('{{ text_warm_sitemap_starting|e('js') }}');
    runBatch();
  });
}
</script>
{{ footer }}
