{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-save" data-toggle="tooltip" title="Save" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ back }}" data-toggle="tooltip" title="Back" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <div id="roko-alert"></div>
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-comments"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form id="form-module" action="{{ save }}" method="post" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_roko_status" id="input-status" class="form-control">
                <option value="1"{% if module_roko_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_roko_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-gemini-api-key"><span data-toggle="tooltip" title="{{ help_gemini_api_key }}">{{ entry_gemini_api_key }}</span></label>
            <div class="col-sm-10">
              <textarea name="module_roko_gemini_api_key" rows="3" placeholder="KEY_1, KEY_2, KEY_3" id="input-gemini-api-key" class="form-control" autocomplete="off">{{ module_roko_gemini_api_key }}</textarea>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-gemini-model">{{ entry_gemini_model }}</label>
            <div class="col-sm-10"><input type="text" name="module_roko_gemini_model" value="{{ module_roko_gemini_model }}" placeholder="gemini-2.5-flash" id="input-gemini-model" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-gemini-temperature">{{ entry_gemini_temperature }}</label>
            <div class="col-sm-10"><input type="number" step="0.1" min="0" max="1" name="module_roko_gemini_temperature" value="{{ module_roko_gemini_temperature }}" id="input-gemini-temperature" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-catalog-limit"><span data-toggle="tooltip" title="{{ help_catalog_limit }}">{{ entry_catalog_limit }}</span></label>
            <div class="col-sm-10"><input type="number" min="5" max="200" name="module_roko_catalog_limit" value="{{ module_roko_catalog_limit }}" id="input-catalog-limit" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-store-brand">{{ entry_store_brand }}</label>
            <div class="col-sm-10"><input type="text" name="module_roko_store_brand" value="{{ module_roko_store_brand }}" id="input-store-brand" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-assistant-name">{{ entry_assistant_name }}</label>
            <div class="col-sm-10"><input type="text" name="module_roko_assistant_name" value="{{ module_roko_assistant_name }}" id="input-assistant-name" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sitemap-url"><span data-toggle="tooltip" title="{{ help_sitemap_url }}">{{ entry_sitemap_url }}</span></label>
            <div class="col-sm-10"><input type="url" name="module_roko_sitemap_url" value="{{ module_roko_sitemap_url }}" placeholder="https://example.com/sitemap.xml" id="input-sitemap-url" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-system-prompt"><span data-toggle="tooltip" title="{{ help_system_prompt }}">{{ entry_system_prompt }}</span></label>
            <div class="col-sm-10"><textarea name="module_roko_system_prompt" rows="5" id="input-system-prompt" class="form-control">{{ module_roko_system_prompt }}</textarea></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-catalog-token"><span data-toggle="tooltip" title="{{ help_catalog_token }}">{{ entry_catalog_token }}</span></label>
            <div class="col-sm-10"><input type="text" name="module_roko_catalog_token" value="{{ module_roko_catalog_token }}" id="input-catalog-token" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-lead-webhook-url"><span data-toggle="tooltip" title="{{ help_lead_webhook_url }}">{{ entry_lead_webhook_url }}</span></label>
            <div class="col-sm-10"><input type="url" name="module_roko_lead_webhook_url" value="{{ module_roko_lead_webhook_url }}" placeholder="https://script.google.com/macros/s/..." id="input-lead-webhook-url" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-lead-webhook-secret"><span data-toggle="tooltip" title="{{ help_lead_webhook_secret }}">{{ entry_lead_webhook_secret }}</span></label>
            <div class="col-sm-10"><input type="text" name="module_roko_lead_webhook_secret" value="{{ module_roko_lead_webhook_secret }}" id="input-lead-webhook-secret" class="form-control" autocomplete="off"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-footer-injection">{{ entry_footer_injection }}</label>
            <div class="col-sm-10">
              <select name="module_roko_footer_injection" id="input-footer-injection" class="form-control">
                <option value="1"{% if module_roko_footer_injection %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_roko_footer_injection %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-widget-title">{{ entry_widget_title }}</label>
            <div class="col-sm-10"><input type="text" name="module_roko_widget_title" value="{{ module_roko_widget_title }}" id="input-widget-title" class="form-control"/></div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-widget-button">{{ entry_widget_button }}</label>
            <div class="col-sm-10"><input type="text" name="module_roko_widget_button" value="{{ module_roko_widget_button }}" id="input-widget-button" class="form-control"/></div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-database"></i> ROKO data</h3>
      </div>
      <div class="panel-body">
        <ul class="nav nav-tabs">
          <li class="active"><a href="#tab-roko-logs" data-toggle="tab"><i class="fa fa-list"></i> {{ text_logs }}</a></li>
          <li><a href="#tab-roko-indexed-pages" data-toggle="tab"><i class="fa fa-sitemap"></i> {{ text_indexed_pages }} <span class="badge">{{ sitemap_pages_total }}</span></a></li>
        </ul>

        <div class="tab-content">
          <div class="tab-pane active" id="tab-roko-logs">
            <div class="clearfix" style="margin: 0 0 10px;">
              <div class="pull-right">
                <a href="{{ export_logs }}" class="btn btn-success btn-xs"><i class="fa fa-file-excel-o"></i> {{ text_export_excel }}</a>
                <button type="button" id="button-clear-logs" data-url="{{ clear_logs }}" class="btn btn-danger btn-xs">{{ text_clear_logs }}</button>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead><tr><td>{{ column_date }}</td><td>{{ column_conversation }}</td><td>{{ column_customer }}</td><td>{{ column_role }}</td><td>{{ column_content }}</td></tr></thead>
                <tbody>
                  {% if logs %}
                    {% for log in logs %}
                      <tr><td>{{ log.date_added }}</td><td><code>{{ log.conversation_id }}</code></td><td>{{ log.customer_id ? log.customer_id : '-' }}</td><td>{{ log.role }}</td><td>{{ log.content|slice(0, 240) }}{% if log.content|length > 240 %}...{% endif %}</td></tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="5" class="text-center">{{ text_no_logs }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>

          <div class="tab-pane" id="tab-roko-indexed-pages">
            <div class="clearfix" style="margin: 0 0 10px;">
              <div class="pull-left" style="padding-top: 6px;"><strong>{{ text_cache_status }}:</strong> {{ sitemap_cache_status }}</div>
              {% if warm_sitemap_url %}
                <div class="pull-right"><a href="{{ warm_sitemap_url }}" target="_blank" rel="noopener" class="btn btn-primary btn-xs"><i class="fa fa-refresh"></i> {{ text_warm_sitemap }}</a></div>
              {% endif %}
            </div>
            <div class="well well-sm">
              <form action="{{ upload_sitemap }}" method="post" enctype="multipart/form-data" class="form-inline">
                <div class="form-group">
                  <label for="input-sitemap-file">{{ text_upload_sitemap }}</label>
                  <input type="file" name="sitemap_file" id="input-sitemap-file" accept=".xml,.gz,.xml.gz" class="form-control">
                </div>
                <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-upload"></i> {{ button_upload_sitemap }}</button>
                <span class="help-block">{{ help_upload_sitemap }}</span>
                <div><strong>{{ text_uploaded_sitemap }}:</strong> {{ uploaded_sitemap_status }}</div>
                <pre style="margin: 8px 0 0; max-height: 180px; overflow: auto; white-space: pre-wrap;">{{ uploaded_sitemap_diagnostics }}</pre>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead><tr><td>{{ column_cached_at }}</td><td>{{ column_type }}</td><td>{{ column_title }}</td><td>{{ column_url }}</td><td>{{ column_summary }}</td></tr></thead>
                <tbody>
                  {% if sitemap_pages %}
                    {% for page in sitemap_pages %}
                      <tr>
                        <td>{{ page.fetched_at }}</td>
                        <td><span class="label label-info">{{ page.content_type }}</span></td>
                        <td>{{ page.title }}</td>
                        <td><a href="{{ page.url }}" target="_blank" rel="noopener">{{ page.url }}</a></td>
                        <td>{{ page.summary }}</td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td colspan="5" class="text-center">{{ text_no_indexed_pages }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
function rokoAlert(type, message) {
  $('#roko-alert').html('<div class="alert alert-' + type + ' alert-dismissible"><i class="fa fa-' + (type === 'danger' ? 'exclamation-circle' : 'check-circle') + '"></i> ' + message + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
}

$('#button-save').on('click', function () {
  $.ajax({
    url: $('#form-module').attr('action'),
    type: 'post',
    dataType: 'json',
    data: $('#form-module').serialize(),
    beforeSend: function () { $('#button-save').button('loading'); },
    complete: function () { $('#button-save').button('reset'); },
    success: function (json) {
      if (json.error) {
        rokoAlert('danger', json.error);
      } else {
        rokoAlert('success', json.success || 'Saved.');
      }
    },
    error: function (xhr) { rokoAlert('danger', xhr.responseText || 'Save failed.'); }
  });
});

$('#button-clear-logs').on('click', function () {
  if (!confirm('{{ text_clear_logs|e('js') }}?')) return;

  $.ajax({
    url: $(this).data('url'),
    type: 'post',
    dataType: 'json',
    success: function () { location.reload(); }
  });
});
//--></script>
{{ footer }}
